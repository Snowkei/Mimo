# ===========================================
# Mimo 博客 - 本地开发环境变量
# ===========================================
# 复制此文件为 .env 并填写实际值
# 此文件仅用于本地开发 (wrangler pages dev)
# 生产部署请使用 deploy.sh 或 Cloudflare Dashboard
# ===========================================

# 站点地址
SITE_URL=https://localhost:4321

# ===== GitHub 配置 =====
GITHUB_TOKEN=your_github_pat_here
GITHUB_OWNER=Snowkei
GITHUB_REPO=Mimo
GITHUB_BRANCH=main
GITHUB_CONTENT_DIR=src/content/blog/

# ===== 图床配置 =====
# 图床类型: r2 / s3 / webdav
IMAGE_HOST_TYPE=r2

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_DOMAIN=
R2_PREFIX=blog/

# --- S3 兼容存储 ---
# S3_ENDPOINT=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_DOMAIN=
# S3_PREFIX=images/
# S3_PATH_STYLE=false

# --- WebDAV ---
# WEBDAV_URL=
# WEBDAV_USERNAME=
# WEBDAV_PASSWORD=
# WEBDAV_DIRECTORY=blog-images/
# WEBDAV_DOMAIN=
