---
const year = new Date().getFullYear();
---

<footer class="border-t border-gray-200 dark:border-gray-800 mt-16">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-gray-500 dark:text-gray-400">
      <p>© {year} 我的博客. All rights reserved.</p>
      <div class="flex items-center gap-4">
        <a href="/rss.xml" class="hover:text-gray-900 dark:hover:text-gray-100 transition-colors">RSS</a>
        <a href="/sitemap-index.xml" class="hover:text-gray-900 dark:hover:text-gray-100 transition-colors">Sitemap</a>
        <span class="text-gray-300 dark:text-gray-700">|</span>
        <span>Powered by <a href="https://astro.build" target="_blank" rel="noopener" class="text-primary-600 dark:text-primary-400 hover:underline">Astro</a> + <a href="https://pages.cloudflare.com" target="_blank" rel="noopener" class="text-primary-600 dark:text-primary-400 hover:underline">Cloudflare</a></span>
      </div>
    </div>
  </div>
</footer>
