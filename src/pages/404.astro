---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 - 页面不存在">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-24 text-center">
    <div class="text-8xl mb-6">🔍</div>
    <h1 class="text-4xl font-bold mb-4">404</h1>
    <p class="text-lg text-gray-500 dark:text-gray-400 mb-8">你要找的页面不存在，或者已经搬走了。</p>
    <div class="flex justify-center gap-3">
      <a href="/" class="px-5 py-2.5 bg-primary-600 hover:bg-primary-700 text-white rounded-lg font-medium transition-colors">
        回到首页
      </a>
      <a href="/blog" class="px-5 py-2.5 border border-gray-300 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-800 rounded-lg font-medium transition-colors">
        浏览文章
      </a>
    </div>
  </div>
</BaseLayout>
