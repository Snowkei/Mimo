---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getReadingTime } from '../../utils';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="文章列表">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
    <h1 class="text-3xl font-bold mb-2">文章</h1>
    <p class="text-gray-500 dark:text-gray-400 mb-8">共 {posts.length} 篇文章</p>

    <div class="space-y-8">
      {posts.map((post) => (
        <a href={`/blog/${post.slug}`} class="post-card block group">
          <article class="p-5 rounded-xl border border-gray-200 dark:border-gray-800 hover:border-primary-300 dark:hover:border-primary-700 transition-colors">
            <div class="flex items-center gap-3 mb-2">
              <time class="text-sm text-gray-400 dark:text-gray-500 font-mono" datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
              <span class="text-xs px-2 py-0.5 rounded-full bg-primary-100 dark:bg-primary-900/40 text-primary-700 dark:text-primary-300">
                {post.data.category}
              </span>
              {post.body && (
                <span class="text-xs text-gray-400 dark:text-gray-500">{getReadingTime(post.body)}</span>
              )}
            </div>
            <h2 class="text-xl font-semibold group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors mb-2">
              {post.data.title}
            </h2>
            {post.data.description && (
              <p class="text-gray-600 dark:text-gray-400 line-clamp-2 mb-3">{post.data.description}</p>
            )}
            <div class="flex flex-wrap gap-2">
              {post.data.tags.map((tag) => (
                <span class="text-xs text-gray-400 dark:text-gray-500" key={tag}>#{tag}</span>
              ))}
            </div>
          </article>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
