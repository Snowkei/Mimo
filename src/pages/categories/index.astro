---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).filter((p) => !p.data.draft);

// 统计每个分类的文章数
const categoryMap = new Map<string, number>();
posts.forEach((post) => {
  const cat = post.data.category;
  categoryMap.set(cat, (categoryMap.get(cat) || 0) + 1);
});

const categories = [...categoryMap.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="分类">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
    <h1 class="text-3xl font-bold mb-8">分类</h1>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {categories.map(([name, count]) => (
        <a
          href={`/categories/${name}`}
          class="group p-5 rounded-xl border border-gray-200 dark:border-gray-800 hover:border-primary-300 dark:hover:border-primary-700 transition-colors"
          key={name}
        >
          <h2 class="text-lg font-semibold group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
            {name}
          </h2>
          <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">{count} 篇文章</p>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
