---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="图床配置">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <h1 class="text-3xl font-bold mb-2">图床配置</h1>
    <p class="text-gray-500 dark:text-gray-400 mb-8">配置你的图床后端，上传和管理图片。</p>

    <!-- 图床类型选择 -->
    <div class="mb-8">
      <label class="block text-sm font-medium mb-3">图床后端</label>
      <div class="grid grid-cols-3 gap-3">
        <button
          id="tab-r2"
          class="tab-btn active px-4 py-3 rounded-xl border-2 border-primary-500 bg-primary-50 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300 font-medium text-sm transition-all"
          data-tab="r2"
        >
          ☁️ Cloudflare R2
        </button>
        <button
          id="tab-s3"
          class="tab-btn px-4 py-3 rounded-xl border-2 border-gray-200 dark:border-gray-700 hover:border-gray-300 dark:hover:border-gray-600 font-medium text-sm transition-all"
          data-tab="s3"
        >
          🪣 S3 兼容
        </button>
        <button
          id="tab-webdav"
          class="tab-btn px-4 py-3 rounded-xl border-2 border-gray-200 dark:border-gray-700 hover:border-gray-300 dark:hover:border-gray-600 font-medium text-sm transition-all"
          data-tab="webdav"
        >
          📂 WebDAV
        </button>
      </div>
    </div>

    <!-- R2 配置 -->
    <div id="config-r2" class="config-panel">
      <div class="space-y-4 mb-8">
        <div>
          <label class="block text-sm font-medium mb-1">Account ID</label>
          <input id="r2-account-id" type="text" placeholder="你的 Cloudflare Account ID"
            class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 focus:ring-2 focus:ring-primary-500 focus:border-transparent outline-none transition-all" />
          <p class="text-xs text-gray-400 mt-1">在 Cloudflare Dashboard 右侧栏找到</p>
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">Access Key ID</label>
          <input id="r2-access-key" type="text" placeholder="R2 Access Key ID"
            class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 focus:ring-2 focus:ring-primary-500 focus:border-transparent outline-none transition-all" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">Secret Access Key</label>
          <input id="r2-secret-key" type="password" placeholder="R2 Secret Access Key"
            class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 focus:ring-2 focus:ring-primary-500 focus:border-transparent outline-none transition-all" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">Bucket 名称</label>
          <input id="r2-bucket" type="text" placeholder="my-blog-images"
            class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 focus:ring-2 focus:ring-primary-500 focus:border-transparent outline-none transition-all" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">自定义域名（可选）</label>
          <input id="r2-domain" type="text" placeholder="https://img.your-domain.com"
            class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 focus:ring-2 focus:ring-primary-500 focus:border-transparent outline-none transition-all" />
          <p class="text-xs text-gray-400 mt-1">设置后将使用自定义域名作为图片 URL 前缀</p>
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">路径前缀</label>
          <input id="r2-prefix" type="text" placeholder="blog/" value="blog/"
            class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 focus:ring-2 focus:ring-primary-500 focus:border-transparent outline-none transition-all" />
        </div>
      </div>
    </div>

    <!-- S3 配置 -->
    <div id="config-s3" class="config-panel hidden">
      <div class="space-y-4 mb-8">
        <div>
          <label class="block text-sm font-medium mb-1">Endpoint</label>
          <input id="s3-endpoint" type="text" placeholder="https://s3.amazonaws.com 或 MinIO 地址"
            class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 focus:ring-2 focus:ring-primary-500 focus:border-transparent outline-none transition-all" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">Region</label>
          <input id="s3-region" type="text" placeholder="us-east-1" value="us-east-1"
            class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 focus:ring-2 focus:ring-primary-500 focus:border-transparent outline-none transition-all" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">Access Key ID</label>
          <input id="s3-access-key" type="text" placeholder="S3 Access Key ID"
            class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 focus:ring-2 focus:ring-primary-500 focus:border-transparent outline-none transition-all" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">Secret Access Key</label>
          <input id="s3-secret-key" type="password" placeholder="S3 Secret Access Key"
            class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 focus:ring-2 focus:ring-primary-500 focus:border-transparent outline-none transition-all" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">Bucket 名称</label>
          <input id="s3-bucket" type="text" placeholder="my-bucket"
            class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 focus:ring-2 focus:ring-primary-500 focus:border-transparent outline-none transition-all" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">自定义域名（可选）</label>
          <input id="s3-domain" type="text" placeholder="https://cdn.your-domain.com"
            class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 focus:ring-2 focus:ring-primary-500 focus:border-transparent outline-none transition-all" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">路径前缀</label>
          <input id="s3-prefix" type="text" placeholder="images/" value="images/"
            class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 focus:ring-2 focus:ring-primary-500 focus:border-transparent outline-none transition-all" />
        </div>
        <div class="flex items-center gap-2">
          <input id="s3-path-style" type="checkbox" class="rounded border-gray-300" />
          <label for="s3-path-style" class="text-sm">使用 Path-style URL（MinIO 等需要）</label>
        </div>
      </div>
    </div>

    <!-- WebDAV 配置 -->
    <div id="config-webdav" class="config-panel hidden">
      <div class="space-y-4 mb-8">
        <div>
          <label class="block text-sm font-medium mb-1">服务器地址</label>
          <input id="webdav-url" type="text" placeholder="https://dav.jianguoyun.com/dav/"
            class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 focus:ring-2 focus:ring-primary-500 focus:border-transparent outline-none transition-all" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">用户名</label>
          <input id="webdav-user" type="text" placeholder="你的 WebDAV 用户名"
            class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 focus:ring-2 focus:ring-primary-500 focus:border-transparent outline-none transition-all" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">密码 / 应用密码</label>
          <input id="webdav-pass" type="password" placeholder="WebDAV 密码或应用专用密码"
            class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 focus:ring-2 focus:ring-primary-500 focus:border-transparent outline-none transition-all" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">上传目录</label>
          <input id="webdav-dir" type="text" placeholder="blog-images/" value="blog-images/"
            class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 focus:ring-2 focus:ring-primary-500 focus:border-transparent outline-none transition-all" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">访问域名（可选）</label>
          <input id="webdav-domain" type="text" placeholder="https://你的域名/路径"
            class="w-full px-4 py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 focus:ring-2 focus:ring-primary-500 focus:border-transparent outline-none transition-all" />
          <p class="text-xs text-gray-400 mt-1">如果文件可通过 URL 直接访问，填入基础 URL</p>
        </div>
      </div>
    </div>

    <!-- 保存配置按钮 -->
    <div class="flex gap-3 mb-10">
      <button id="save-config" class="px-5 py-2.5 bg-primary-600 hover:bg-primary-700 text-white rounded-lg font-medium transition-colors">
        💾 保存配置
      </button>
      <button id="test-config" class="px-5 py-2.5 border border-gray-300 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-800 rounded-lg font-medium transition-colors">
        🔗 测试连接
      </button>
    </div>

    <!-- 配置状态 -->
    <div id="config-status" class="hidden mb-8 p-4 rounded-lg text-sm"></div>

    <!-- 上传区域 -->
    <div class="border-t border-gray-200 dark:border-gray-800 pt-8">
      <h2 class="text-xl font-semibold mb-4">上传图片</h2>

      <div id="upload-zone" class="upload-zone mb-6">
        <div class="flex flex-col items-center gap-3">
          <div class="w-16 h-16 rounded-full bg-gray-100 dark:bg-gray-800 flex items-center justify-center text-2xl">
            📤
          </div>
          <div>
            <p class="font-medium">拖拽图片到这里</p>
            <p class="text-sm text-gray-500 dark:text-gray-400">或点击选择文件（支持多选）</p>
          </div>
          <input id="file-input" type="file" accept="image/*" multiple class="hidden" />
        </div>
      </div>

      <!-- 上传进度 -->
      <div id="upload-progress" class="hidden mb-6">
        <div class="flex items-center gap-3 mb-2">
          <div class="w-4 h-4 border-2 border-primary-500 border-t-transparent rounded-full animate-spin"></div>
          <span class="text-sm">上传中...</span>
        </div>
        <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2">
          <div id="progress-bar" class="bg-primary-500 h-2 rounded-full transition-all duration-300" style="width: 0%"></div>
        </div>
      </div>

      <!-- 已上传图片列表 -->
      <div id="uploaded-images" class="space-y-3"></div>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  // ========== 配置管理 ==========
  const CONFIG_KEY = 'blog_image_host_config';

  function getConfig() {
    try {
      return JSON.parse(localStorage.getItem(CONFIG_KEY) || '{}');
    } catch { return {}; }
  }

  function saveConfig(config) {
    localStorage.setItem(CONFIG_KEY, JSON.stringify(config));
  }

  function loadConfigToForm() {
    const config = getConfig();
    if (!config.type) return;

    // 切换到对应的 tab
    switchTab(config.type);

    // 填充表单
    if (config.type === 'r2') {
      document.getElementById('r2-account-id').value = config.accountId || '';
      document.getElementById('r2-access-key').value = config.accessKeyId || '';
      document.getElementById('r2-secret-key').value = config.secretAccessKey || '';
      document.getElementById('r2-bucket').value = config.bucket || '';
      document.getElementById('r2-domain').value = config.domain || '';
      document.getElementById('r2-prefix').value = config.prefix || 'blog/';
    } else if (config.type === 's3') {
      document.getElementById('s3-endpoint').value = config.endpoint || '';
      document.getElementById('s3-region').value = config.region || 'us-east-1';
      document.getElementById('s3-access-key').value = config.accessKeyId || '';
      document.getElementById('s3-secret-key').value = config.secretAccessKey || '';
      document.getElementById('s3-bucket').value = config.bucket || '';
      document.getElementById('s3-domain').value = config.domain || '';
      document.getElementById('s3-prefix').value = config.prefix || 'images/';
      document.getElementById('s3-path-style').checked = config.pathStyle || false;
    } else if (config.type === 'webdav') {
      document.getElementById('webdav-url').value = config.url || '';
      document.getElementById('webdav-user').value = config.username || '';
      document.getElementById('webdav-pass').value = config.password || '';
      document.getElementById('webdav-dir').value = config.directory || 'blog-images/';
      document.getElementById('webdav-domain').value = config.domain || '';
    }

    showStatus('已加载保存的配置', 'info');
  }

  function readConfigFromForm(type) {
    if (type === 'r2') {
      return {
        type: 'r2',
        accountId: document.getElementById('r2-account-id').value.trim(),
        accessKeyId: document.getElementById('r2-access-key').value.trim(),
        secretAccessKey: document.getElementById('r2-secret-key').value.trim(),
        bucket: document.getElementById('r2-bucket').value.trim(),
        domain: document.getElementById('r2-domain').value.trim(),
        prefix: document.getElementById('r2-prefix').value.trim() || 'blog/',
      };
    } else if (type === 's3') {
      return {
        type: 's3',
        endpoint: document.getElementById('s3-endpoint').value.trim(),
        region: document.getElementById('s3-region').value.trim() || 'us-east-1',
        accessKeyId: document.getElementById('s3-access-key').value.trim(),
        secretAccessKey: document.getElementById('s3-secret-key').value.trim(),
        bucket: document.getElementById('s3-bucket').value.trim(),
        domain: document.getElementById('s3-domain').value.trim(),
        prefix: document.getElementById('s3-prefix').value.trim() || 'images/',
        pathStyle: document.getElementById('s3-path-style').checked,
      };
    } else if (type === 'webdav') {
      return {
        type: 'webdav',
        url: document.getElementById('webdav-url').value.trim(),
        username: document.getElementById('webdav-user').value.trim(),
        password: document.getElementById('webdav-pass').value.trim(),
        directory: document.getElementById('webdav-dir').value.trim() || 'blog-images/',
        domain: document.getElementById('webdav-domain').value.trim(),
      };
    }
    return null;
  }

  // ========== Tab 切换 ==========
  let currentTab = 'r2';

  function switchTab(tab) {
    currentTab = tab;
    document.querySelectorAll('.tab-btn').forEach((btn) => {
      const isActive = btn.dataset.tab === tab;
      btn.classList.toggle('active', isActive);
      btn.classList.toggle('border-primary-500', isActive);
      btn.classList.toggle('bg-primary-50', isActive);
      btn.classList.toggle('dark:bg-primary-900/30', isActive);
      btn.classList.toggle('text-primary-700', isActive);
      btn.classList.toggle('dark:text-primary-300', isActive);
      btn.classList.toggle('border-gray-200', !isActive);
      btn.classList.toggle('dark:border-gray-700', !isActive);
    });
    document.querySelectorAll('.config-panel').forEach((panel) => {
      panel.classList.toggle('hidden', panel.id !== `config-${tab}`);
    });
  }

  document.querySelectorAll('.tab-btn').forEach((btn) => {
    btn.addEventListener('click', () => switchTab(btn.dataset.tab));
  });

  // ========== 保存和测试 ==========
  function showStatus(message, type = 'info') {
    const el = document.getElementById('config-status');
    el.classList.remove('hidden');
    const colors = {
      success: 'bg-green-50 dark:bg-green-950/30 text-green-700 dark:text-green-300 border border-green-200 dark:border-green-800',
      error: 'bg-red-50 dark:bg-red-950/30 text-red-700 dark:text-red-300 border border-red-200 dark:border-red-800',
      info: 'bg-blue-50 dark:bg-blue-950/30 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800',
    };
    el.className = `mb-8 p-4 rounded-lg text-sm ${colors[type] || colors.info}`;
    el.textContent = message;
    if (type === 'success' || type === 'info') {
      setTimeout(() => el.classList.add('hidden'), 3000);
    }
  }

  document.getElementById('save-config').addEventListener('click', () => {
    const config = readConfigFromForm(currentTab);
    if (!config) return showStatus('未知的图床类型', 'error');

    // 验证必填项
    const required = currentTab === 'r2'
      ? ['accountId', 'accessKeyId', 'secretAccessKey', 'bucket']
      : currentTab === 's3'
      ? ['endpoint', 'accessKeyId', 'secretAccessKey', 'bucket']
      : ['url', 'username', 'password'];
    const missing = required.filter((k) => !config[k]);
    if (missing.length) return showStatus(`请填写必填项: ${missing.join(', ')}`, 'error');

    saveConfig(config);
    showStatus('✅ 配置已保存到本地浏览器', 'success');
  });

  document.getElementById('test-config').addEventListener('click', () => {
    const config = readConfigFromForm(currentTab);
    if (!config) return showStatus('请先填写配置', 'error');
    showStatus('ℹ️ 连接测试需要通过 API 后端执行，请先保存配置后上传图片测试', 'info');
  });

  // ========== 上传功能 ==========
  const uploadZone = document.getElementById('upload-zone');
  const fileInput = document.getElementById('file-input');

  uploadZone.addEventListener('click', () => fileInput.click());
  uploadZone.addEventListener('dragover', (e) => {
    e.preventDefault();
    uploadZone.classList.add('dragover');
  });
  uploadZone.addEventListener('dragleave', () => uploadZone.classList.remove('dragover'));
  uploadZone.addEventListener('drop', (e) => {
    e.preventDefault();
    uploadZone.classList.remove('dragover');
    handleFiles(e.dataTransfer.files);
  });
  fileInput.addEventListener('change', () => handleFiles(fileInput.files));

  async function handleFiles(files) {
    const config = getConfig();
    if (!config.type) return showStatus('请先配置图床并保存', 'error');

    const progressEl = document.getElementById('upload-progress');
    const progressBar = document.getElementById('progress-bar');
    const imagesList = document.getElementById('uploaded-images');
    progressEl.classList.remove('hidden');

    for (let i = 0; i < files.length; i++) {
      const file = files[i];
      const pct = ((i + 1) / files.length) * 100;
      progressBar.style.width = `${pct}%`;

      try {
        const result = await uploadFile(file, config);
        const url = result.url;

        const item = document.createElement('div');
        item.className = 'flex items-center gap-3 p-3 rounded-lg bg-gray-50 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700';
        item.innerHTML = `
          <img src="${url}" alt="${file.name}" class="w-16 h-16 object-cover rounded-lg" />
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium truncate">${file.name}</p>
            <input type="text" value="${url}" readonly
              class="w-full mt-1 px-2 py-1 text-xs bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 rounded font-mono text-gray-600 dark:text-gray-400"
              onclick="this.select(); navigator.clipboard.writeText(this.value);" />
          </div>
          <button class="shrink-0 px-3 py-1.5 text-xs bg-primary-100 dark:bg-primary-900/40 text-primary-700 dark:text-primary-300 rounded-lg hover:bg-primary-200 dark:hover:bg-primary-900/60 transition-colors"
            onclick="navigator.clipboard.writeText('${url}'); this.textContent='已复制!'; setTimeout(() => this.textContent='复制链接', 1000);">
            复制链接
          </button>
        `;
        imagesList.prepend(item);
      } catch (err) {
        showStatus(`上传失败: ${err.message}`, 'error');
      }
    }

    setTimeout(() => {
      progressEl.classList.add('hidden');
      progressBar.style.width = '0%';
    }, 1000);
  }

  async function uploadFile(file, config) {
    // 客户端直接调用 S3/R2 兼容 API（使用签名上传）
    // 对于 WebDAV，使用 WebDAV PUT
    const formData = new FormData();
    formData.append('file', file);
    formData.append('config', JSON.stringify(config));

    const resp = await fetch('/api/upload', {
      method: 'POST',
      body: formData,
    });

    if (!resp.ok) {
      const err = await resp.json().catch(() => ({ error: '上传失败' }));
      throw new Error(err.error || '上传失败');
    }

    return resp.json();
  }

  // 页面加载时读取配置
  loadConfigToForm();
</script>
