---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => !p.data.draft);
  const allTags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return allTags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts
        .filter((p) => p.data.tags.includes(tag))
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`标签: ${tag}`}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
    <div class="flex items-center gap-3 mb-8">
      <a href="/tags" class="text-sm text-primary-600 dark:text-primary-400 hover:underline">← 全部标签</a>
    </div>
    <h1 class="text-3xl font-bold mb-8">#{tag}</h1>
    <div class="space-y-4">
      {posts.map((post) => (
        <a href={`/blog/${post.slug}`} class="post-card block group">
          <article class="flex items-baseline gap-4 p-4 rounded-xl border border-gray-200 dark:border-gray-800 hover:border-primary-300 dark:hover:border-primary-700 transition-colors">
            <time class="text-sm text-gray-400 font-mono shrink-0" datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString('zh-CN', { month: '2-digit', day: '2-digit' })}
            </time>
            <div>
              <h2 class="font-medium group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                {post.data.title}
              </h2>
              <span class="text-xs text-gray-400 dark:text-gray-500">{post.data.category}</span>
            </div>
          </article>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
