---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="写文章">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-6 sm:py-12">
    <h1 class="text-2xl sm:text-3xl font-bold mb-1 sm:mb-2">✍️ 写文章</h1>
    <p class="text-sm sm:text-base text-gray-500 dark:text-gray-400 mb-6 sm:mb-8">在线编写并发布 Markdown 文章到博客。</p>

    <!-- 未配置提示 -->
    <div id="not-configured" class="hidden mb-6 p-4 sm:p-5 rounded-xl border border-amber-200 dark:border-amber-800 bg-amber-50 dark:bg-amber-950/30">
      <p class="text-amber-700 dark:text-amber-300 font-medium mb-2">⚠️ 尚未配置 GitHub</p>
      <p class="text-sm text-amber-600 dark:text-amber-400 mb-3">发布文章需要先在设置中配置 GitHub Token 和仓库信息。</p>
      <a href="/settings" class="inline-block px-4 py-2 bg-primary-600 hover:bg-primary-700 text-white rounded-lg text-sm font-medium transition-colors">
        前往设置 →
      </a>
    </div>

    <!-- 已配置状态条 -->
    <div id="configured-bar" class="hidden mb-4 sm:mb-6 flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400">
      <span class="w-2 h-2 rounded-full bg-green-500 shrink-0"></span>
      <span class="truncate">已连接 <code class="font-mono text-gray-700 dark:text-gray-300" id="repo-display"></code></span>
      <a href="/settings" class="text-primary-600 dark:text-primary-400 hover:underline ml-1 shrink-0">修改</a>
    </div>

    <!-- 文章表单 -->
    <div id="editor-section">
      <!-- 标题 + 分类 -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-4">
        <div class="sm:col-span-2">
          <label class="block text-sm font-medium mb-1">文章标题 *</label>
          <input id="post-title" type="text" placeholder="输入文章标题"
            class="w-full px-3 sm:px-4 py-2 sm:py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 focus:ring-2 focus:ring-primary-500 focus:border-transparent outline-none transition-all text-base sm:text-lg font-medium" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">分类</label>
          <input id="post-category" type="text" placeholder="未分类"
            class="w-full px-3 sm:px-4 py-2 sm:py-2.5 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 focus:ring-2 focus:ring-primary-500 focus:border-transparent outline-none transition-all" />
        </div>
      </div>

      <!-- 折叠：高级选项 -->
      <details class="mb-4 group">
        <summary class="text-sm font-medium text-gray-500 dark:text-gray-400 cursor-pointer hover:text-gray-700 dark:hover:text-gray-300 select-none mb-3 list-none flex items-center gap-1">
          <svg class="w-4 h-4 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          更多选项（描述、标签、日期、封面图）
        </summary>
        <div class="space-y-4 p-4 rounded-lg bg-gray-50 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700">
          <div>
            <label class="block text-sm font-medium mb-1">描述（SEO）</label>
            <input id="post-description" type="text" placeholder="简短的文章描述，用于搜索引擎"
              class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 focus:ring-2 focus:ring-primary-500 focus:border-transparent outline-none transition-all text-sm" />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">标签（逗号分隔）</label>
            <input id="post-tags" type="text" placeholder="标签1, 标签2, 标签3"
              class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 focus:ring-2 focus:ring-primary-500 focus:border-transparent outline-none transition-all text-sm" />
          </div>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium mb-1">发布日期</label>
              <input id="post-date" type="date"
                class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 focus:ring-2 focus:ring-primary-500 focus:border-transparent outline-none transition-all text-sm" />
            </div>
            <div>
              <label class="block text-sm font-medium mb-1">更新日期</label>
              <input id="post-updated" type="date"
                class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 focus:ring-2 focus:ring-primary-500 focus:border-transparent outline-none transition-all text-sm" />
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">封面图 URL</label>
            <input id="post-hero" type="text" placeholder="https://..."
              class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 focus:ring-2 focus:ring-primary-500 focus:border-transparent outline-none transition-all text-sm" />
          </div>
          <div class="flex items-center gap-6">
            <label class="flex items-center gap-2 cursor-pointer">
              <input id="post-draft" type="checkbox" class="rounded border-gray-300 text-primary-600 focus:ring-primary-500" />
              <span class="text-sm">草稿</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input id="post-pinned" type="checkbox" class="rounded border-gray-300 text-primary-600 focus:ring-primary-500" />
              <span class="text-sm">置顶</span>
            </label>
          </div>
        </div>
      </details>

      <!-- Markdown 编辑器 -->
      <div class="mb-4">
        <div class="flex items-center justify-between mb-1.5">
          <label class="block text-sm font-medium">正文内容 *</label>
          <button id="toggle-preview" class="text-xs px-2.5 py-1 rounded-md bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors sm:hidden">
            预览
          </button>
        </div>

        <div class="relative">
          <textarea id="post-content" rows="16" placeholder="在这里编写 Markdown 内容..."
            class="w-full px-3 sm:px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 focus:ring-2 focus:ring-primary-500 focus:border-transparent outline-none transition-all font-mono text-sm leading-relaxed resize-y"></textarea>
          <div id="preview-panel" class="hidden w-full px-3 sm:px-4 py-3 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 overflow-auto max-h-[500px] prose prose-sm dark:prose-invert"></div>
        </div>

        <!-- 工具栏：桌面端内联，移动端底部固定 -->
        <div class="hidden sm:flex items-center gap-1 mt-1.5">
          <button data-action="bold" class="toolbar-btn" title="粗体"><b>B</b></button>
          <button data-action="italic" class="toolbar-btn" title="斜体"><i>I</i></button>
          <button data-action="heading" class="toolbar-btn" title="标题">H</button>
          <button data-action="link" class="toolbar-btn" title="链接">🔗</button>
          <button data-action="image" class="toolbar-btn" title="图片">🖼️</button>
          <button data-action="code" class="toolbar-btn" title="代码块">&lt;/&gt;</button>
          <button data-action="quote" class="toolbar-btn" title="引用">❝</button>
          <button data-action="list" class="toolbar-btn" title="列表">☰</button>
          <span class="mx-1 text-gray-300 dark:text-gray-600">|</span>
          <button id="toggle-preview-desktop" class="toolbar-btn text-xs" title="预览">预览</button>
        </div>
      </div>

      <!-- 文件名预览 -->
      <div class="mb-4 p-2.5 sm:p-3 rounded-lg bg-gray-50 dark:bg-gray-800/50 border border-gray-200 dark:border-gray-700 overflow-x-auto">
        <p class="text-xs text-gray-500 dark:text-gray-400 whitespace-nowrap">
          📄 <code id="file-path-preview" class="font-mono text-primary-600 dark:text-primary-400">src/content/blog/your-title.md</code>
        </p>
      </div>

      <!-- Commit 信息 -->
      <div class="mb-4">
        <label class="block text-sm font-medium mb-1">Commit 信息</label>
        <input id="commit-msg" type="text" placeholder="Add: 文章标题"
          class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 focus:ring-2 focus:ring-primary-500 focus:border-transparent outline-none transition-all text-sm" />
      </div>

      <!-- 发布按钮 -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 sm:gap-3">
        <button id="publish-btn" class="px-5 py-2.5 bg-primary-600 hover:bg-primary-700 text-white rounded-lg font-medium transition-colors flex items-center justify-center gap-2 text-sm sm:text-base">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
          发布文章
        </button>
        <button id="save-draft-btn" class="px-5 py-2.5 border border-gray-300 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-800 rounded-lg font-medium transition-colors text-sm sm:text-base">
          保存为草稿
        </button>
      </div>

      <div id="publish-status" class="hidden mt-4 p-3 sm:p-4 rounded-lg text-sm"></div>
    </div>
  </div>

  <!-- 移动端底部固定工具栏 -->
  <div id="mobile-toolbar" class="fixed bottom-0 left-0 right-0 z-40 sm:hidden bg-white dark:bg-gray-900 border-t border-gray-200 dark:border-gray-700 px-2 py-1.5 flex items-center gap-0.5 overflow-x-auto no-scrollbar">
    <button data-action="bold" class="m-toolbar-btn" title="粗体"><b>B</b></button>
    <button data-action="italic" class="m-toolbar-btn" title="斜体"><i>I</i></button>
    <button data-action="heading" class="m-toolbar-btn" title="标题">H</button>
    <button data-action="link" class="m-toolbar-btn" title="链接">🔗</button>
    <button data-action="image" class="m-toolbar-btn" title="图片">🖼️</button>
    <button data-action="code" class="m-toolbar-btn" title="代码块">&lt;/&gt;</button>
    <button data-action="quote" class="m-toolbar-btn" title="引用">❝</button>
    <button data-action="list" class="m-toolbar-btn" title="列表">☰</button>
    <div class="w-px h-6 bg-gray-200 dark:bg-gray-700 mx-1 shrink-0"></div>
    <button id="m-undo" class="m-toolbar-btn" title="撤销">↩</button>
    <button id="m-redo" class="m-toolbar-btn" title="重做">↪</button>
  </div>
</BaseLayout>

<style>
  .toolbar-btn {
    @apply px-2 py-1 rounded text-sm text-gray-500 dark:text-gray-400
           hover:bg-gray-100 dark:hover:bg-gray-700 hover:text-gray-700 dark:hover:text-gray-200
           transition-colors cursor-pointer;
  }
  .m-toolbar-btn {
    @apply w-9 h-9 flex items-center justify-center rounded-lg text-sm text-gray-600 dark:text-gray-400
           hover:bg-gray-100 dark:hover:bg-gray-800 active:bg-gray-200 dark:active:bg-gray-700
           transition-colors cursor-pointer shrink-0;
  }
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

  /* 移动端给底部工具栏留空间 */
  @media (max-width: 639px) {
    #editor-section { padding-bottom: 56px; }
  }
</style>

<script is:inline>
  const GH_KEY = 'blog_github_config';

  function getGHConfig() {
    try { return JSON.parse(localStorage.getItem(GH_KEY) || '{}'); }
    catch { return {}; }
  }

  function slugify(text) {
    return text
      .toLowerCase()
      .replace(/[^\w\u4e00-\u9fff\u3040-\u30ff\uac00-\ud7af -]/g, '')
      .replace(/[\s_]+/g, '-')
      .replace(/-+/g, '-')
      .replace(/^-|-$/g, '') || 'untitled';
  }

  // 初始化：检查配置
  const ghConfig = getGHConfig();
  if (ghConfig.token && ghConfig.owner && ghConfig.repo) {
    document.getElementById('configured-bar').classList.remove('hidden');
    document.getElementById('repo-display').textContent = `${ghConfig.owner}/${ghConfig.repo}`;
  } else {
    document.getElementById('not-configured').classList.remove('hidden');
    document.getElementById('editor-section').style.opacity = '0.4';
    document.getElementById('editor-section').style.pointerEvents = 'none';
  }

  // 文件名 & commit 自动填充
  function updateFilePath() {
    const title = document.getElementById('post-title').value.trim();
    const slug = slugify(title);
    const dir = ghConfig.contentDir || 'src/content/blog/';
    document.getElementById('file-path-preview').textContent = `${dir}${slug}.md`;
    const commitInput = document.getElementById('commit-msg');
    if (!commitInput.dataset.manual) {
      commitInput.value = title ? `Add: ${title}` : '';
    }
  }

  document.getElementById('post-title').addEventListener('input', updateFilePath);
  document.getElementById('commit-msg').addEventListener('input', (e) => {
    e.target.dataset.manual = '1';
  });

  document.getElementById('post-date').value = new Date().toISOString().split('T')[0];

  // ========== Markdown 工具栏 ==========
  const textarea = document.getElementById('post-content');

  function wrapSelection(before, after) {
    const start = textarea.selectionStart;
    const end = textarea.selectionEnd;
    const text = textarea.value;
    const selected = text.slice(start, end) || '文本';
    textarea.value = text.slice(0, start) + before + selected + after + text.slice(end);
    textarea.focus();
    textarea.setSelectionRange(start + before.length, start + before.length + selected.length);
  }

  function insertAtCursor(text) {
    const start = textarea.selectionStart;
    textarea.value = textarea.value.slice(0, start) + text + textarea.value.slice(start);
    textarea.focus();
    textarea.setSelectionRange(start + text.length, start + text.length);
  }

  function doToolbarAction(action) {
    if (action === 'bold') wrapSelection('**', '**');
    else if (action === 'italic') wrapSelection('*', '*');
    else if (action === 'heading') insertAtCursor('\n## 标题\n');
    else if (action === 'link') wrapSelection('[', '](https://url)');
    else if (action === 'image') insertAtCursor('\n![图片描述](https://url)\n');
    else if (action === 'code') insertAtCursor('\n```\n代码\n```\n');
    else if (action === 'quote') insertAtCursor('\n> 引用内容\n');
    else if (action === 'list') insertAtCursor('\n- 列表项\n');
  }

  // 桌面工具栏
  document.querySelectorAll('.toolbar-btn[data-action]').forEach(btn => {
    btn.addEventListener('click', () => doToolbarAction(btn.dataset.action));
  });
  // 移动端工具栏
  document.querySelectorAll('.m-toolbar-btn[data-action]').forEach(btn => {
    btn.addEventListener('click', () => doToolbarAction(btn.dataset.action));
  });

  // 撤销/重做
  document.getElementById('m-undo')?.addEventListener('click', () => document.execCommand('undo'));
  document.getElementById('m-redo')?.addEventListener('click', () => document.execCommand('redo'));

  // ========== 预览 ==========
  function renderPreview() {
    return textarea.value
      .replace(/^### (.+)$/gm, '<h3>$1</h3>')
      .replace(/^## (.+)$/gm, '<h2>$1</h2>')
      .replace(/^# (.+)$/gm, '<h1>$1</h1>')
      .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
      .replace(/\*(.+?)\*/g, '<em>$1</em>')
      .replace(/`(.+?)`/g, '<code>$1</code>')
      .replace(/^> (.+)$/gm, '<blockquote>$1</blockquote>')
      .replace(/^- (.+)$/gm, '<li>$1</li>')
      .replace(/\n{2,}/g, '</p><p>')
      .replace(/^(.+)$/gm, (m) => m.startsWith('<') ? m : `<p>${m}</p>`)
      .replace(/<li>/g, '<ul><li>').replace(/<\/li>(?!\s*<li>)/g, '</li></ul>')
      .replace(/<\/ul>\s*<ul>/g, '');
  }

  let previewMode = false;
  function togglePreview() {
    previewMode = !previewMode;
    const editor = document.getElementById('post-content');
    const preview = document.getElementById('preview-panel');
    if (previewMode) {
      editor.classList.add('hidden');
      preview.classList.remove('hidden');
      preview.innerHTML = renderPreview();
      document.querySelectorAll('#toggle-preview, #toggle-preview-desktop').forEach(b => { if (b) b.textContent = '编辑'; });
      // 隐藏移动端工具栏
      document.getElementById('mobile-toolbar').classList.add('hidden');
    } else {
      editor.classList.remove('hidden');
      preview.classList.add('hidden');
      document.querySelectorAll('#toggle-preview, #toggle-preview-desktop').forEach(b => { if (b) b.textContent = '预览'; });
      document.getElementById('mobile-toolbar').classList.remove('hidden');
    }
  }

  document.getElementById('toggle-preview')?.addEventListener('click', togglePreview);
  document.getElementById('toggle-preview-desktop')?.addEventListener('click', togglePreview);

  // ========== 构建 Markdown ==========
  function buildMarkdownContent() {
    const title = document.getElementById('post-title').value.trim();
    const description = document.getElementById('post-description').value.trim();
    const date = document.getElementById('post-date').value;
    const updatedDate = document.getElementById('post-updated').value;
    const category = document.getElementById('post-category').value.trim() || '未分类';
    const tags = document.getElementById('post-tags').value.split(/[,，]/).map(t => t.trim()).filter(Boolean);
    const heroImage = document.getElementById('post-hero').value.trim();
    const draft = document.getElementById('post-draft').checked;
    const pinned = document.getElementById('post-pinned').checked;
    const content = document.getElementById('post-content').value;

    let fm = '---\n';
    fm += `title: "${title}"\n`;
    if (description) fm += `description: "${description}"\n`;
    fm += `pubDate: ${date}\n`;
    if (updatedDate) fm += `updatedDate: ${updatedDate}\n`;
    fm += `category: "${category}"\n`;
    if (tags.length) fm += `tags: [${tags.map(t => `"${t}"`).join(', ')}]\n`;
    if (heroImage) fm += `heroImage: "${heroImage}"\n`;
    fm += `draft: ${draft}\n`;
    fm += `pinned: ${pinned}\n`;
    fm += '---\n\n';
    fm += content;
    return fm;
  }

  // ========== 发布 ==========
  async function publishToGitHub(isDraft) {
    const config = getGHConfig();
    if (!config.token || !config.owner || !config.repo) {
      return showStatus('请先在 <a href="/settings" class="underline">设置</a> 中配置 GitHub', 'error');
    }

    const title = document.getElementById('post-title').value.trim();
    if (!title) return showStatus('请输入文章标题', 'error');
    if (!document.getElementById('post-content').value.trim()) return showStatus('请输入文章内容', 'error');

    if (isDraft) document.getElementById('post-draft').checked = true;

    const dir = config.contentDir || 'src/content/blog/';
    const branch = config.branch || 'main';
    const slug = slugify(title);
    const filePath = `${dir}${slug}.md`;
    const content = buildMarkdownContent();
    const commitMsg = document.getElementById('commit-msg').value.trim() || `Add: ${title}`;

    const btn = document.getElementById(isDraft ? 'save-draft-btn' : 'publish-btn');
    const originalText = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg> 提交中...';

    try {
      let sha = null;
      const checkResp = await fetch(
        `https://api.github.com/repos/${config.owner}/${config.repo}/contents/${filePath}`,
        { headers: { 'Authorization': `token ${config.token}`, 'Accept': 'application/vnd.github.v3+json' } }
      );
      if (checkResp.ok) sha = (await checkResp.json()).sha;

      const body = {
        message: commitMsg,
        content: btoa(unescape(encodeURIComponent(content))),
        branch,
      };
      if (sha) body.sha = sha;

      const resp = await fetch(
        `https://api.github.com/repos/${config.owner}/${config.repo}/contents/${filePath}`,
        {
          method: 'PUT',
          headers: { 'Authorization': `token ${config.token}`, 'Accept': 'application/vnd.github.v3+json', 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        }
      );

      if (!resp.ok) {
        const err = await resp.json().catch(() => ({}));
        throw new Error(err.message || `GitHub API 错误: ${resp.status}`);
      }

      const action = sha ? '更新' : '创建';
      showStatus(
        `✅ 文章${action}成功！<a href="https://github.com/${config.owner}/${config.repo}/blob/${branch}/${filePath}" target="_blank" class="underline">查看文件</a>`,
        'success'
      );
      if (!isDraft) {
        setTimeout(() => showStatus('🚀 文章已提交，等待部署...', 'info'), 3000);
      }
    } catch (err) {
      showStatus(`❌ 发布失败: ${err.message}`, 'error');
    } finally {
      btn.disabled = false;
      btn.innerHTML = originalText;
    }
  }

  document.getElementById('publish-btn').addEventListener('click', () => publishToGitHub(false));
  document.getElementById('save-draft-btn').addEventListener('click', () => publishToGitHub(true));

  function showStatus(message, type = 'info') {
    const el = document.getElementById('publish-status');
    el.classList.remove('hidden');
    const colors = {
      success: 'bg-green-50 dark:bg-green-950/30 text-green-700 dark:text-green-300 border border-green-200 dark:border-green-800',
      error: 'bg-red-50 dark:bg-red-950/30 text-red-700 dark:text-red-300 border border-red-200 dark:border-red-800',
      info: 'bg-blue-50 dark:bg-blue-950/30 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800',
    };
    el.className = `mt-4 p-3 sm:p-4 rounded-lg text-sm ${colors[type] || colors.info}`;
    el.innerHTML = message;
    if (type === 'info') setTimeout(() => el.classList.add('hidden'), 5000);
  }
</script>
